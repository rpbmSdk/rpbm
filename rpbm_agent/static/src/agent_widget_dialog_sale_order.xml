<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rpbm_agent.SaleOrderDialog" t-inherit="rpbm_agent.AgentWidgetDialog" t-inherit-mode="primary">
        <xpath expr="//div[@name='selected_article_actions']" position="inside">
            <t t-if="selectedProduct">
                <t t-if="selectedProductInOrder">
                    <span class="ms-2">Article déjà présent dans le devis.</span>
                </t>
                <button t-else="" class="btn btn-primary btn-sm ms-2" t-on-click="addSelectedProductToSaleOrder">Ajouter au devis</button>
            </t>
        </xpath>
    </t>
</templates>
