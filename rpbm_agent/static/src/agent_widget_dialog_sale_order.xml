<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rpbm_agent.SaleOrderDialog" t-inherit="rpbm_agent.AgentWidgetDialog" t-inherit-mode="primary">
        <xpath expr="//section[@name='vsf_section']" position="before">
            <!-- Lot E2 : sans X'Glass, le dossier en lecture seule ; le bouton sert aussi à réessayer. -->
            <section t-if="!agentsInitialized" name="xglass_summary" class="mb-4">
                <h5>Dossier</h5>
                <dl class="row mb-2">
                    <t t-foreach="recordSummary" t-as="line" t-key="line[0]">
                        <dt class="col-sm-3" t-esc="line[0]"/>
                        <dd class="col-sm-9" t-esc="line[1]"/>
                    </t>
                </dl>
                <div t-if="authError" class="alert alert-danger" role="alert" t-esc="authError"/>
                <button class="btn btn-primary" t-on-click="startAgents" t-att-disabled="isLoading or state.xglassLoading">Charger X'Glass</button>
                <span t-if="isLoading" class="ms-2"><i class="fa fa-spinner fa-spin me-1"/><t t-esc="loadingMessage"/></span>
            </section>
            <section t-if="selectedPiece or laborOperations.length" name="xglass_labor" class="mb-4">
                <h5>4. Main d'œuvre X'Glass</h5>
                <p class="form-text">Sélectionnez les opérations à ajouter au devis. Le tarif est celui du service Odoo associé.</p>
                <t t-if="laborOperations.length">
                    <div class="list-group">
                        <t t-foreach="laborOperations" t-as="operation" t-key="operation.key">
                            <div class="list-group-item d-flex justify-content-between align-items-center gap-2">
                                <label class="mb-0 flex-grow-1">
                                    <input class="form-check-input me-2" type="checkbox" t-att-checked="isLaborOperationSelected(operation)" t-att-disabled="operation.unavailableReason || isLaborOperationInOrder(operation)" t-on-change="()=>this.toggleLaborOperation(operation)"/>
                                    <strong><t t-esc="operation.label"/></strong> — <t t-esc="operation.duration"/> h (<t t-esc="operation.rate || 'taux inconnu'"/>)
                                </label>
                                <span t-if="operation.unavailableReason" class="text-warning small"><t t-esc="operation.unavailableReason"/></span>
                                <button t-elif="isLaborOperationInOrder(operation)" class="btn btn-outline-danger btn-sm" t-on-click="()=>this.removeLaborOperation(operation)">Retirer</button>
                            </div>
                        </t>
                    </div>
                    <button class="btn btn-primary btn-sm mt-2" t-on-click="addSelectedLaborOperations">Ajouter les opérations sélectionnées</button>
                </t>
                <span t-else="" class="text-muted">Aucune opération de main-d'œuvre n'est fournie pour cette pièce.</span>
            </section>
        </xpath>
        <xpath expr="//section[@name='vsf_section']/h5" position="replace">
            <h5>5. Article VSF</h5>
        </xpath>
    </t>
    <!-- Actions devis, ajoutées à l'encart commun. Le template est partagé avec la
         dialog CRM : le garde-fou sur addArticleToSaleOrder (défini seulement par
         AgentWidgetDialogSaleOrder) limite ces boutons au devis. -->
    <t t-name="rpbm_agent.SaleOrderArticleActions" t-inherit="rpbm_agent.ArticleActions" t-inherit-mode="extension">
        <xpath expr="//div[@name='article_actions']" position="inside">
            <t t-if="addArticleToSaleOrder and getProductForArticle(actionArticle.code)">
                <t t-if="isWidgetArticleInOrder(actionArticle.code)">
                    <button class="btn btn-outline-danger btn-sm ms-2" t-on-click.stop="()=>this.removeArticleFromSaleOrder(actionArticle.code)">Retirer du devis</button>
                </t>
                <t t-elif="isArticleAlreadyInOrder(actionArticle.code)">
                    <span class="ms-2">Article déjà présent dans le devis.</span>
                </t>
                <button t-else="" class="btn btn-primary btn-sm ms-2" t-on-click.stop="()=>this.addArticleToSaleOrder(actionArticle.code)">Ajouter au devis</button>
            </t>
        </xpath>
    </t>
</templates>
