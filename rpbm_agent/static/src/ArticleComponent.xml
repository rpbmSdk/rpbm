<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Deux lignes racines, à placer dans un tbody : l'article, puis son détail s'il est sélectionné. -->
    <t t-name="rpbm_agent.ArticleComponent">
        <tr role="button" t-att-class="props.selected ? 'table-primary' : ''" t-on-click="props.onSelect">
            <td class="font-monospace text-nowrap"><t t-esc="props.article.code"/></td>
            <td>
                <t t-esc="props.article.name"/>
                <a t-if="props.article.url" t-att-href="props.article.url" target="_blank" rel="noopener" class="ms-2 small" t-on-click.stop="">Fiche technique</a>
            </td>
            <td><t t-esc="props.article.refConstructeur"/></td>
            <td class="text-end">
                <t t-if="props.article.available === false">Indisponible</t>
                <t t-else="" t-esc="props.article.stock"/>
            </td>
            <t t-set="hasPrice" t-value="props.article.prixVente !== undefined and props.article.prixVente !== null"/>
            <td class="text-end text-nowrap"><t t-if="hasPrice"><t t-esc="props.article.prixVente"/> €</t></td>
            <td class="text-end text-nowrap"><t t-if="hasPrice"><t t-esc="props.article.prixVenteRPBM"/> €</t></td>
            <td>
                <t t-if="props.article.images and props.article.images.length" t-call="rpbm_agent.ArticleThumbnail">
                    <t t-set="image" t-value="props.article.images[0]"/>
                    <t t-set="thumbnailSize" t-value="'width: 64px; height: 48px;'"/>
                </t>
            </td>
        </tr>
        <tr t-if="props.selected">
            <td colspan="7">
                <div t-if="props.article.images and props.article.images.length" class="d-flex flex-wrap align-items-start gap-2 mb-2">
                    <t t-foreach="props.article.images" t-as="image" t-key="image.thumbnailUrl">
                        <t t-call="rpbm_agent.ArticleThumbnail">
                            <t t-set="thumbnailSize" t-value="'width: 96px; height: 72px;'"/>
                        </t>
                    </t>
                </div>
                <dl t-if="props.article.technicalDetails and props.article.technicalDetails.length" class="row mb-0 small">
                    <t t-foreach="props.article.technicalDetails" t-as="detail" t-key="detail.label + detail.value">
                        <dt class="col-5 mb-1"><t t-esc="detail.label"/></dt>
                        <dd class="col-7 mb-1"><t t-esc="detail.value"/></dd>
                    </t>
                </dl>
                <p t-if="props.article.detailsUnavailable" class="text-warning small mt-2 mb-0">Détails VSF indisponibles pour cet article.</p>
                <t t-slot="actions"/>
            </td>
        </tr>
    </t>

    <!-- Vignette VSF : un clic simple ouvre l'aperçu ; Ctrl+clic et clic milieu
         gardent l'ouverture native dans un nouvel onglet (R16). -->
    <t t-name="rpbm_agent.ArticleThumbnail">
        <a t-if="image.fullUrl" t-att-href="image.fullUrl" target="_blank" rel="noopener" class="d-inline-block" title="Agrandir l'image de l'article" t-on-click="(event) => this.openImage(event, image.fullUrl)" t-on-auxclick="stopImagePropagation">
            <img t-att-src="image.thumbnailUrl" class="img-thumbnail" t-attf-style="{{thumbnailSize}} object-fit: contain; cursor: zoom-in;" alt="Image article VSF"/>
        </a>
        <img t-else="" t-att-src="image.thumbnailUrl" class="img-thumbnail" t-attf-style="{{thumbnailSize}} object-fit: contain;" alt="Image article VSF"/>
    </t>
</templates>
