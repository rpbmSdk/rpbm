<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rpbm_agent.AgentWidgetDialog">
        <Dialog size="'fullscreen'" title="'Assistant véhicule et pièces'">
            <t t-if="!agentsInitialized">
                <div t-if="!authError" class="d-flex justify-content-center">
                    <i class="fa fa-spinner fa-spin fa-2x me-2"/>
                    <t t-esc="loadingMessage"/>
                </div>
                <div t-else="" class="alert alert-danger d-flex align-items-center gap-3" role="alert">
                    <span class="flex-grow-1"><t t-esc="authError"/></span>
                    <button class="btn btn-outline-danger btn-sm" t-on-click="startAgents">Réessayer</button>
                </div>
            </t>
            <t t-else="">
                <div t-att-class="isReconnecting ? 'pe-none opacity-50' : ''" t-att-aria-busy="isReconnecting">
                    <div t-if="isReconnecting" class="alert alert-warning d-flex align-items-center gap-2" role="status">
                        <i class="fa fa-spinner fa-spin"/>
                        Reconnexion aux portails et restauration du contexte en cours...
                    </div>
                <section class="mb-4">
                    <h5>1. Véhicule</h5>
                    <div class="d-flex flex-wrap gap-2 align-items-end">
                        <div class="d-flex flex-column">
                            <label for="immatriculation" class="form-label mb-1">Immatriculation</label>
                            <input class="o_input text-uppercase" id="immatriculation" t-att-value="immatriculationValue" placeholder="Immatriculation" t-ref="immatriculation" t-on-change="onChangeImmatriculation"/>
                        </div>
                        <button class="btn btn-primary" t-on-click="onSearchImmatriculation">Rechercher</button>
                    </div>
                    <div t-if="vehicules.length > 0" class="row mt-2 g-2">
                        <t t-foreach="vehicules" t-as="vehicule" t-key="vehicule.id">
                            <div class="col-12 col-md-6">
                                <VehiculeComponent record="record" vehicule="vehicule" vehiculeMeta="vehicule.id === selectedVehiculeId ? vehiculeMeta : undefined" immatriculation="immatriculationValue" selectedVehiculeId="selectedVehiculeId" t-on-click="()=>this.onClickVehicule(vehicule.id)"/>
                            </div>
                        </t>
                    </div>
                </section>

                <section t-if="planche" class="mb-4">
                    <h5>2. Catégorie</h5>
                    <div class="d-flex flex-wrap gap-2">
                        <t t-foreach="visibleCalques" t-as="calque" t-key="calque.id">
                            <CalqueComponent calque="calque" selectedCalqueId="selectedCalqueId" t-on-click="()=>this.onClickCalque(calque.id)"/>
                        </t>
                        <button t-if="selectedCalque and !showAllCalques" class="btn btn-outline-secondary btn-sm" t-on-click="showOtherCalques">Afficher les autres</button>
                    </div>
                    <div t-if="selectedCalque" class="mt-3">
                        <label for="pieceConcernee" class="form-label">Pièce concernée</label>
                        <select id="pieceConcernee" class="o_input" t-att-value="pieceConcernee" t-on-change="onChangePieceConcernee">
                            <t t-foreach="pieceConcerneeOptions" t-as="option" t-key="option[0]">
                                <option t-att-value="option[0]" t-att-selected="option[0] === pieceConcernee"><t t-esc="option[1]"/></option>
                            </t>
                        </select>
                        <div class="form-text">Suggestion modifiable avant confirmation ; elle alimente le calcul legacy de pose.</div>
                    </div>
                </section>

                <section t-if="selectedCalque" class="mb-4">
                    <h5>3. Pièce</h5>
                    <!-- Groupes X'Glass (principales, complémentaires) puis familles (elementSitId).
                         Chaque famille garde son encart « Autres marques AM » replié, même sans carte affichée. -->
                    <t t-foreach="visiblePieceGroups" t-as="group" t-key="group.key">
                        <h6 class="mt-3 mb-2" t-esc="group.titre"/>
                        <t t-foreach="group.familles" t-as="famille" t-key="famille.elementSitId">
                            <div class="mb-3">
                                <div class="border-start border-3 border-primary bg-light px-2 py-1 mb-2 fw-bold" t-esc="famille.libelle"/>
                                <t t-set="famillePieces" t-value="visibleFamillePieces(famille)"/>
                                <div t-if="famillePieces.length" class="row g-2">
                                    <t t-foreach="famillePieces" t-as="piece" t-key="piece.id">
                                        <div t-att-class="piece.id === selectedPieceId ? 'col-12' : 'col-12 col-lg-6'">
                                            <PieceComponent piece="piece" selectedPieceId="selectedPieceId" t-on-click="()=>this.onSelectPiece(piece.id)"/>
                                            <div t-if="piece.id === selectedPieceId and piece.PiecesAM and piece.PiecesAM.length > 0" class="mt-3 border rounded bg-light p-3">
                                                <div class="d-flex align-items-center gap-2 mb-2">
                                                    <span class="badge text-bg-primary">Pièce sélectionnée</span>
                                                    <strong>Détails pour : <t t-esc="piece.pieceOe.libelle"/></strong>
                                                </div>
                                                <div class="row g-2">
                                                    <t t-foreach="piece.PiecesAM" t-as="metaPieceAM" t-key="metaPieceAM.pieceAm.id">
                                                        <div class="col-12 col-md-6">
                                                            <PieceAMComponent metaPieceAM="metaPieceAM" selectedPieceAMId="selectedPieceAMId" t-on-click="()=>this.onSelectPieceAM(metaPieceAM)"/>
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                                <t t-set="familleAutresAm" t-value="autresAmFor(famille)"/>
                                <t t-set="familleAutresAmOpen" t-value="isAutresAmOpen(famille)"/>
                                <div class="mt-2 border rounded">
                                    <button type="button" class="btn btn-light w-100 text-start fw-bold" t-att-aria-expanded="familleAutresAmOpen ? 'true' : 'false'" t-on-click="()=>this.onToggleAutresAm(famille)">
                                        <i t-att-class="familleAutresAmOpen ? 'fa fa-caret-down me-2' : 'fa fa-caret-right me-2'"/>Autres marques AM
                                    </button>
                                    <div t-if="familleAutresAmOpen and familleAutresAm" class="p-2">
                                        <div t-if="familleAutresAm.loading" class="text-muted">
                                            <i class="fa fa-spinner fa-spin me-1"/> Chargement des autres marques AM…
                                        </div>
                                        <div t-elif="!familleAutresAm.entries.length" class="text-muted">Aucune autre référence après-marché.</div>
                                        <div t-else="" class="list-group list-group-flush">
                                            <t t-foreach="familleAutresAm.entries" t-as="metaPieceAM" t-key="metaPieceAM.pieceAm.id">
                                                <PieceAMComponent metaPieceAM="metaPieceAM" selectedPieceAMId="selectedPieceAMId" compact="true" t-on-click="()=>this.onSelectPieceAM(metaPieceAM)"/>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                    <button t-if="(selectedPiece or hasRestoredPieceContext) and !showAllPieces" class="btn btn-outline-secondary btn-sm mt-2" t-on-click="showOtherPieces">Afficher les autres</button>
                </section>

                <section t-if="showVsfSection" name="vsf_section" class="mb-4">
                    <h5>4. Article VSF</h5>
                    <div class="d-flex flex-wrap gap-2 align-items-end">
                        <div>
                            <label for="baseEurocode" class="form-label">Base Eurocode</label>
                            <input class="o_input" id="baseEurocode" t-att-value="baseEurocodeInput" placeholder="Base Eurocode" t-ref="baseEurocode" t-on-input="onInputBaseEurocode" t-on-change="onChangeBaseEurocode"/>
                        </div>
                        <button name="vsf_search" class="btn btn-primary" t-on-click="onSearchBaseEurocode">Rechercher sur VSF</button>
                        <a t-att-class="vsfSearchUrl ? 'btn btn-outline-primary' : 'btn btn-outline-primary disabled'" t-att-href="vsfSearchUrl" target="_blank" rel="noopener" t-att-aria-disabled="vsfSearchUrl ? 'false' : 'true'" t-att-tabindex="vsfSearchUrl ? undefined : -1">Ouvrir dans un nouvel onglet</a>
                    </div>
                    <!-- Un tbody par article principal. Sélection par la prop onSelect : un t-on-click
                         sur le composant écouterait aussi sa ligne de détail. -->
                    <table t-if="articlesVsf.length" name="vsf_articles" class="table table-sm table-hover align-middle mt-2">
                        <thead>
                            <tr>
                                <th>Eurocode</th>
                                <th>Désignation</th>
                                <th>Réf. constructeur</th>
                                <th class="text-end">Stock</th>
                                <th class="text-end">Prix</th>
                                <th class="text-end">Coût</th>
                                <th>Photo</th>
                            </tr>
                        </thead>
                        <tbody t-foreach="articlesVsf" t-as="articleVsf" t-key="articleVsf.code">
                            <ArticleComponent record="record" article="articleVsf" selected="isArticleSelected(articleVsf.code)" onOpenImage.bind="openImagePreview" onSelect="() => this.onClickArticleVsf(articleVsf.code)">
                                <t t-set-slot="actions">
                                    <t t-if="isArticleSelected(articleVsf.code)">
                                        <t t-set="actionArticle" t-value="articleVsf"/>
                                        <t t-call="rpbm_agent.ArticleActions"/>
                                    </t>
                                </t>
                            </ArticleComponent>
                            <t t-if="isArticleSelected(articleVsf.code) and articleVsf.suggestedArticles and articleVsf.suggestedArticles.length">
                                <tr><td colspan="7" class="ps-4 small fw-bold">Articles suggérés par VSF</td></tr>
                                <t t-foreach="articleVsf.suggestedArticles" t-as="suggestion" t-key="suggestion.code">
                                    <ArticleComponent record="record" article="suggestion" selected="isArticleSelected(suggestion.code)" onOpenImage.bind="openImagePreview" onSelect="() => this.onClickSuggestedArticle(suggestion.code, articleVsf.code)">
                                        <t t-set-slot="actions">
                                            <t t-if="isArticleSelected(suggestion.code)">
                                                <t t-set="actionArticle" t-value="suggestion"/>
                                                <t t-call="rpbm_agent.ArticleActions"/>
                                            </t>
                                        </t>
                                    </ArticleComponent>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    <!-- t-if et non t-elif : l'opportunité retire la table par XPath. -->
                    <p t-if="!articlesVsf.length and state.vsfNoResultFor" name="vsf_no_result" class="text-muted mt-2">Aucun article VSF pour « <t t-esc="state.vsfNoResultFor"/> ».</p>
                </section>
                </div>
            </t>
            <t t-set-slot="footer">
                <button t-if="reconnectRequired" class="btn btn-warning" t-on-click="onReconnect" t-att-disabled="isReconnecting">
                    <i t-if="isReconnecting" class="fa fa-spinner fa-spin me-1"/>
                    Reconnecter
                </button>
                <button class="btn btn-primary" t-on-click="onConfirm" t-att-disabled="!state.canConfirm or isReconnecting or state.writing or isLoading">Confirmer</button>
                <button class="btn btn-secondary" t-on-click="onConfirmAndSave" t-att-disabled="!state.canConfirm or isReconnecting or state.writing or isLoading">Confirmer et enregistrer</button>
                <button class="btn btn-outline-secondary" t-on-click="onDiscard" t-att-disabled="isReconnecting">Annuler</button>
            </t>
        </Dialog>
    </t>

    <!-- Encart d'actions d'un article VSF sélectionné (principal ou suggéré), dans sa ligne de détail.
         Attend `actionArticle` dans le scope de l'appelant. La dialog devis
         l'étend (agent_widget_dialog_sale_order.xml). -->
    <t t-name="rpbm_agent.ArticleActions">
        <div name="article_actions" class="alert alert-light border mt-2 mb-0" t-on-click.stop="">
            <button t-att-class="isPrimaryArticle(actionArticle.code) ? 'btn btn-success btn-sm mb-2' : 'btn btn-outline-primary btn-sm mb-2'" t-on-click.stop="()=>this.setPrimaryArticle(actionArticle.code)">
                <t t-if="isPrimaryArticle(actionArticle.code)">Article principal</t>
                <t t-else="">Définir comme article principal</t>
            </button>
            <t t-if="isArticleLoading(actionArticle.code)">
                <i class="fa fa-spinner fa-spin me-1"/> Chargement de l'article VSF…
            </t>
            <t t-else="">
                <t t-set="articleProduct" t-value="getProductForArticle(actionArticle.code)"/>
                <t t-if="articleProduct">
                    <span>Produit Odoo trouvé (<t t-esc="productMatchLabel(articleProduct)"/>).</span>
                    <a class="btn btn-outline-primary btn-sm ms-2" t-att-href="productOdooUrl(articleProduct)" target="_blank">Voir le produit</a>
                </t>
                <t t-else="">
                    <span>Article absent de la base Odoo.</span>
                    <button class="btn btn-primary btn-sm ms-2" t-on-click.stop="()=>this.createProductForArticle(actionArticle.code)">Créer le produit</button>
                </t>
            </t>
        </div>
    </t>
</templates>
