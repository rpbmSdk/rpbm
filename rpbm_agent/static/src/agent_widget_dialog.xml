<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rpbm_agent.AgentWidgetDialog">
        <Dialog size="xl" title="'Assistant véhicule et pièces'">
            <t t-if="!agentsInitialized">
                <div class="d-flex justify-content-center">
                    <i class="fa fa-spinner fa-spin fa-2x me-2"/>
                    <t t-esc="loadingMessage"/>
                </div>
            </t>
            <t t-else="">
                <div t-att-class="isReconnecting ? 'pe-none opacity-50' : ''" t-att-aria-busy="isReconnecting">
                    <div t-if="isReconnecting" class="alert alert-warning d-flex align-items-center gap-2" role="status">
                        <i class="fa fa-spinner fa-spin"/>
                        Reconnexion aux portails et restauration du contexte en cours...
                    </div>
                <section class="mb-4">
                    <h5>1. Véhicule</h5>
                    <div class="d-flex flex-wrap gap-2 align-items-end">
                        <div class="d-flex flex-column">
                            <label for="immatriculation" class="form-label mb-1">Immatriculation</label>
                            <input class="o_input text-uppercase" id="immatriculation" t-att-value="immatriculationValue" placeholder="Immatriculation" t-ref="immatriculation" t-on-change="onChangeImmatriculation"/>
                        </div>
                        <button class="btn btn-primary" t-on-click="onSearchImmatriculation">Rechercher</button>
                    </div>
                    <div t-if="vehicules.length > 0" class="row mt-2 g-2">
                        <t t-foreach="vehicules" t-as="vehicule" t-key="vehicule.id">
                            <div class="col-12 col-md-6">
                                <VehiculeComponent record="record" vehicule="vehicule" vehiculeMeta="vehicule.id === selectedVehiculeId ? vehiculeMeta : undefined" immatriculation="immatriculationValue" selectedVehiculeId="selectedVehiculeId" t-on-click="()=>this.onSelectVehicule(vehicule.id)"/>
                            </div>
                        </t>
                    </div>
                </section>

                <section t-if="planche" class="mb-4">
                    <h5>2. Catégorie</h5>
                    <div class="d-flex flex-wrap gap-2">
                        <t t-foreach="calques" t-as="calque" t-key="calque.id">
                            <CalqueComponent calque="calque" selectedCalqueId="selectedCalqueId" t-on-click="()=>this.onClickCalque(calque.id)"/>
                        </t>
                    </div>
                    <div t-if="selectedCalque" class="mt-3">
                        <label for="pieceConcernee" class="form-label">Pièce concernée</label>
                        <select id="pieceConcernee" class="o_input" t-att-value="pieceConcernee" t-on-change="onChangePieceConcernee">
                            <t t-foreach="pieceConcerneeOptions" t-as="option" t-key="option">
                                <option t-att-value="option" t-att-selected="option === pieceConcernee"><t t-esc="option"/></option>
                            </t>
                        </select>
                        <div class="form-text">Suggestion modifiable avant confirmation ; elle alimente le calcul legacy de pose.</div>
                    </div>
                </section>

                <section t-if="selectedCalque" class="mb-4">
                    <h5>3. Pièce</h5>
                    <div t-if="pieces.length > 0" class="row g-2">
                        <t t-foreach="pieces" t-as="piece" t-key="piece.id">
                            <div class="col-12 col-lg-6">
                                <PieceComponent piece="piece" selectedPieceId="selectedPieceId" t-on-click="()=>this.onSelectPiece(piece.id)"/>
                                <div t-if="piece.id === selectedPieceId and piece.PiecesAM and piece.PiecesAM.length > 0" class="mt-3 border rounded bg-light p-3">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="badge text-bg-primary">Pièce sélectionnée</span>
                                        <strong>Détails pour : <t t-esc="piece.pieceOe.libelle"/></strong>
                                    </div>
                                    <div class="row g-2">
                                        <t t-foreach="piece.PiecesAM" t-as="metaPieceAM" t-key="metaPieceAM.pieceAm.id">
                                            <div class="col-12 col-md-6">
                                                <PieceAMComponent metaPieceAM="metaPieceAM" selectedPieceAMId="selectedPieceAMId" t-on-click="()=>this.onSelectPieceAM(metaPieceAM.pieceAm.id)"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </section>

                <section t-if="selectedPiece" class="mb-4">
                    <h5>4. Article VSF</h5>
                    <div class="d-flex flex-wrap gap-2 align-items-end">
                        <div>
                            <label for="baseEurocode" class="form-label">Base Eurocode</label>
                            <input class="o_input" id="baseEurocode" t-att-value="baseEurocode" placeholder="Base Eurocode" t-ref="baseEurocode" t-on-change="onChangeBaseEurocode"/>
                        </div>
                        <button class="btn btn-primary" t-on-click="onSearchBaseEurocode">Rechercher sur VSF</button>
                    </div>
                    <div t-if="articlesVsf.length > 0" class="row g-2 mt-2">
                        <t t-foreach="articlesVsf" t-as="articleVsf" t-key="articleVsf.code">
                            <div t-att-class="isArticleSelected(articleVsf.code) ? 'col-12' : 'col-12 col-lg-6'">
                                <ArticleComponent record="record" article="articleVsf" selected="isArticleSelected(articleVsf.code)" onOpenImage.bind="openImagePreview" t-on-click="()=>this.onClickArticleVsf(articleVsf.code)">
                                    <t t-set-slot="actions">
                                        <t t-if="isArticleSelected(articleVsf.code)">
                                            <t t-set="actionArticle" t-value="articleVsf"/>
                                            <div name="selected_main_article_actions" class="alert alert-light border mt-2 mb-0" t-on-click.stop="">
                                                <button t-att-class="isPrimaryArticle(actionArticle.code) ? 'btn btn-success btn-sm mb-2' : 'btn btn-outline-primary btn-sm mb-2'" t-on-click.stop="()=>this.setPrimaryArticle(actionArticle.code)">
                                                    <t t-if="isPrimaryArticle(actionArticle.code)">Article principal</t>
                                                    <t t-else="">Définir comme article principal</t>
                                                </button>
                                                <t t-if="isArticleLoading(actionArticle.code)">
                                                    <i class="fa fa-spinner fa-spin me-1"/> Chargement de l'article VSF…
                                                </t>
                                                <t t-else="">
                                                    <t t-set="articleProduct" t-value="getProductForArticle(actionArticle.code)"/>
                                                    <t t-if="articleProduct">
                                                        <span>Produit Odoo trouvé (<t t-esc="productMatchLabel(articleProduct)"/>).</span>
                                                        <a class="btn btn-outline-primary btn-sm ms-2" t-att-href="productOdooUrl(articleProduct)" target="_blank">Voir le produit</a>
                                                    </t>
                                                    <t t-else="">
                                                        <span>Article absent de la base Odoo.</span>
                                                        <button class="btn btn-primary btn-sm ms-2" t-att-disabled="isArticleLoading(actionArticle.code)" t-on-click.stop="()=>this.createProductForArticle(actionArticle.code)">Créer le produit</button>
                                                    </t>
                                                </t>
                                            </div>
                                        </t>
                                    </t>
                                </ArticleComponent>
                                <div t-if="isArticleSelected(articleVsf.code) and articleVsf.suggestedArticles and articleVsf.suggestedArticles.length" class="border rounded mt-2 p-3">
                                    <h6 class="mb-3">Articles suggérés par VSF</h6>
                                    <div class="row g-2">
                                        <t t-foreach="articleVsf.suggestedArticles" t-as="suggestion" t-key="suggestion.code">
                                            <div class="col-12 col-md-6">
                                                <ArticleComponent record="record" article="suggestion" selected="isArticleSelected(suggestion.code)" onOpenImage.bind="openImagePreview" t-on-click="()=>this.onClickSuggestedArticle(suggestion.code, articleVsf.code)">
                                                    <t t-set-slot="actions">
                                                        <t t-if="isArticleSelected(suggestion.code)">
                                                            <t t-set="actionArticle" t-value="suggestion"/>
                                                            <div name="selected_suggested_article_actions" class="alert alert-light border mt-2 mb-0" t-on-click.stop="">
                                                                <button t-att-class="isPrimaryArticle(actionArticle.code) ? 'btn btn-success btn-sm mb-2' : 'btn btn-outline-primary btn-sm mb-2'" t-on-click.stop="()=>this.setPrimaryArticle(actionArticle.code)">
                                                                    <t t-if="isPrimaryArticle(actionArticle.code)">Article principal</t>
                                                                    <t t-else="">Définir comme article principal</t>
                                                                </button>
                                                                <t t-if="isArticleLoading(actionArticle.code)">
                                                                    <i class="fa fa-spinner fa-spin me-1"/> Chargement de l'article VSF…
                                                                </t>
                                                                <t t-else="">
                                                                    <t t-set="articleProduct" t-value="getProductForArticle(actionArticle.code)"/>
                                                                    <t t-if="articleProduct">
                                                                        <span>Produit Odoo trouvé (<t t-esc="productMatchLabel(articleProduct)"/>).</span>
                                                                        <a class="btn btn-outline-primary btn-sm ms-2" t-att-href="productOdooUrl(articleProduct)" target="_blank">Voir le produit</a>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <span>Article absent de la base Odoo.</span>
                                                                        <button class="btn btn-primary btn-sm ms-2" t-att-disabled="isArticleLoading(actionArticle.code)" t-on-click.stop="()=>this.createProductForArticle(actionArticle.code)">Créer le produit</button>
                                                                    </t>
                                                                </t>
                                                            </div>
                                                        </t>
                                                    </t>
                                                </ArticleComponent>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </section>
                </div>
            </t>
            <t t-set-slot="footer">
                <button t-if="reconnectRequired" class="btn btn-warning" t-on-click="onReconnect" t-att-disabled="isReconnecting">
                    <i t-if="isReconnecting" class="fa fa-spinner fa-spin me-1"/>
                    Reconnecter
                </button>
                <button class="btn btn-primary" t-on-click="onConfirm" t-att-disabled="!state.canConfirm or isReconnecting">Confirmer</button>
                <button class="btn btn-secondary" t-on-click="onConfirmAndSave" t-att-disabled="!state.canConfirm or isReconnecting">Confirmer et enregistrer</button>
                <button class="btn btn-outline-secondary" t-on-click="onDiscard" t-att-disabled="isReconnecting">Annuler</button>
            </t>
        </Dialog>
    </t>
</templates>
