<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rpbm_agent.PieceAMComponent">
        <div class="card h-100">
            <div class="card-body" t-att-style="style">
                <h6 class="card-title">
                    <t t-esc="pieceAM.libelle"/>
                </h6>
                <div t-if="fournisseur">Fournisseur : <t t-esc="fournisseur"/></div>
                <div>Référence : <t t-esc="pieceAM.reference"/></div>
                <div t-if="dateLibelle">Validité : <t t-esc="dateLibelle"/></div>
                <div t-if="description">Description : <t t-esc="description"/></div>
                <div t-if="hasPrix">Prix : <t t-esc="pieceAM.prix"/></div>
            </div>
        </div>
    </t>
</templates>
