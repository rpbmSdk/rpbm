<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="rpbm_agent.VsfImagePreviewDialog">
        <Dialog size="'xl'" title="'Aperçu de l’image VSF'">
            <div class="text-center">
                <p t-if="props.images.length > 1" class="text-muted small mb-2">
                    Photo <t t-esc="state.index + 1"/> / <t t-esc="props.images.length"/> — utiliser ← et → pour naviguer.
                </p>
                <img t-att-src="imageUrl" class="img-fluid" style="max-height: 80vh;" t-att-alt="imageAlt"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">Fermer</button>
            </t>
        </Dialog>
    </t>
</templates>
