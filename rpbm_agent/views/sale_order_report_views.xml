                <div class="col-12">
                    <span><strong>Mode de remise / lieu : </strong></span>
                    <t t-if="doc.carrier_id">
                        <span t-field="doc.carrier_id"/>
                        <span t-if="doc.carrier_id.carrier_description"
                              t-out="doc.carrier_id.carrier_description"/>
                    </t>
                    <t t-elif="doc.opportunity_id.x_studio_lieu_intervention">
                        <span t-field="doc.opportunity_id.x_studio_lieu_intervention"/>
                    </t>
                    <t t-else="">
                        <span>Non renseigné</span>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

    <!--
        1519 — RPBM Devis / Commande brouillon : ajout du mode de remise
        uniquement. Le bloc vehicule de ce rapport est deja unique ; il lit en
        revanche `x_studio_marque__1` / `x_studio_modle_` (2/7353 renseignes),
        donc marque et modele y sortent vides. Ce constat est hors perimetre de
        ce lot (aucune consigne de changement de source sur 4921) et remonte a
        la roadmap.
