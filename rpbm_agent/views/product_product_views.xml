<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_normal_form_rpbm_agent" model="ir.ui.view">
        <field name="name">product.product.form.rpbm.agent</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- Pas default_code : mrp_plm l'a remplacé par un bloc sans libellé (avec « Version »). -->
            <field name="barcode" position="before">
                <field name="rpbm_eurocode"/>
                <field name="rpbm_width_mm"/>
                <field name="rpbm_length_mm"/>
            </field>
            <notebook position="inside">
                <page name="rpbm_agent_xglass" string="VSF">
                    <group>
                        <field name="rpbm_constructor_reference"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
