<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_rpbm_carrier" model="ir.ui.view">
        <field name="name">sale.order.form.rpbm.carrier</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority" eval="110"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//field[@name='partner_id']" position="after">
                <field name="carrier_id"
                       string="Transporteur / mode de remise"
                       placeholder="Choisir Galleria, Genipa ou Camion avant confirmation"
                       options="{'no_create': True, 'no_open': True}"
                       readonly="state in ['sale', 'cancel'] or locked"/>
            </xpath>
        </field>
    </record>
</odoo>
