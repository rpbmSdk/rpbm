<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_rpbm_agent" model="ir.ui.view">
        <field name="name">sale.order.form.rpbm.agent</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="rpbm_agent_xglass" string="Véhicule (X'Glass)" invisible="not opportunity_id">
                    <group>
                        <field name="opportunity_id" invisible="1"/>
                        <widget name="rpbm_agent_widget"/>
                        <field name="x_studio_vehicle_id"/>
                        <field name="x_studio_categorie_xglass"/>
                    </group>
                    <group string="Identité véhicule (Fleet)">
                        <field name="x_rpbm_vehicle_brand_id"/>
                        <field name="x_rpbm_vehicle_model_id"/>
                        <field name="x_rpbm_vehicle_vin"/>
                        <field name="x_rpbm_vehicle_detail_model"/>
                        <field name="x_rpbm_vehicle_fuel_type"/>
                        <field name="x_rpbm_vehicle_date_mec"/>
                    </group>
                    <group invisible="1">
                        <field name="x_studio_eurocode_complet"/>
                        <field name="x_studio_vsf_dsignation_1"/>
                        <field name="x_studio_vsf_qt_dispo"/>
                        <field name="x_rpbm_vsf_constructor_reference"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
