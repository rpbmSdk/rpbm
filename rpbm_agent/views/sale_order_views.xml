<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_rpbm_agent" model="ir.ui.view">
        <field name="name">sale.order.form.rpbm.agent</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree" position="inside">
                <field name="rpbm_xglass_price" column_invisible="True"/>
                <field name="rpbm_labor_operation_key" column_invisible="True"/>
            </xpath>
            <notebook position="inside">
                <page name="rpbm_agent_xglass" string="Véhicule (X'Glass)" invisible="not opportunity_id">
                    <field name="opportunity_id" invisible="1"/>
                    <group>
                        <group string="Véhicule">
                            <widget name="rpbm_agent_widget" colspan="2"/>
                            <field name="rpbm_vehicle_id"/>
                            <field name="rpbm_license_plate"/>
                            <field name="rpbm_vehicle_brand_id"/>
                            <field name="rpbm_vehicle_model_id"/>
                            <field name="rpbm_vehicle_detail_model"/>
                            <field name="rpbm_vin"/>
                            <field name="rpbm_fuel_type"/>
                            <field name="rpbm_first_registration_date"/>
                        </group>
                        <group string="Pièce et article">
                            <field name="rpbm_xglass_category"/>
                            <field name="rpbm_part_type"/>
                            <field name="rpbm_eurocode_base"/>
                            <field name="rpbm_eurocode"/>
                            <field name="rpbm_vsf_designation"/>
                            <field name="rpbm_vsf_stock"/>
                            <field name="rpbm_constructor_reference"/>
                            <field name="rpbm_intervention_location"/>
                        </group>
                    </group>
                    <group invisible="1">
                        <field name="rpbm_xglass_piece_id"/>
                        <field name="rpbm_piece_oe_id"/>
                        <field name="rpbm_piece_am_id"/>
                        <field name="rpbm_xglass_vehicle_id"/>
                        <field name="rpbm_xglass_piece_label"/>
                        <field name="rpbm_xglass_labor_operations"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Hérite aussi des listes devis et commandes (vues primaires filles). -->
    <record id="view_sale_order_tree_rpbm_agent" model="ir.ui.view">
        <field name="name">sale.order.tree.rpbm.agent</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="rpbm_license_plate" optional="show"/>
                <field name="rpbm_vehicle_brand_id" optional="show"/>
                <field name="rpbm_vehicle_model_id" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Hérite aussi des recherches devis et commandes. Pas de <separator/> : il décalerait les
         xpaths positionnels des personnalisations Studio. -->
    <record id="view_sale_order_search_rpbm_agent" model="ir.ui.view">
        <field name="name">sale.order.search.rpbm.agent</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="rpbm_license_plate"/>
                <field name="rpbm_vehicle_brand_id"/>
                <field name="rpbm_vehicle_model_id"/>
                <field name="rpbm_vin"/>
                <field name="rpbm_eurocode"/>
                <field name="rpbm_license_plate" string="Véhicule"
                       filter_domain="['|','|','|',('rpbm_license_plate','ilike',self),('rpbm_vin','ilike',self),('rpbm_vehicle_brand_id.name','ilike',self),('rpbm_vehicle_model_id.name','ilike',self)]"/>
            </field>
            <xpath expr="//group" position="inside">
                <filter name="group_by_rpbm_vehicle_brand" string="Marque du véhicule" context="{'group_by': 'rpbm_vehicle_brand_id'}"/>
                <filter name="group_by_rpbm_vehicle_model" string="Modèle du véhicule" context="{'group_by': 'rpbm_vehicle_model_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
