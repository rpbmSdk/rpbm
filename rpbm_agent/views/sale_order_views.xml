<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_rpbm_agent" model="ir.ui.view">
        <field name="name">sale.order.form.rpbm.agent</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="rpbm_agent_xglass" string="Véhicule (X'Glass)" invisible="not opportunity_id">
                    <group>
                        <field name="opportunity_id" invisible="1"/>
                        <widget name="rpbm_agent_widget"/>
                        <field name="x_studio_vehicle_id"/>
                        <field name="x_studio_categorie_xglass"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
