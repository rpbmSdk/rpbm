<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_rpbm_pricing" model="ir.ui.view">
        <field name="name">purchase.order.form.rpbm.pricing</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_ref" position="after">
                <field name="rpbm_transport_mode"/>
            </field>
        </field>
    </record>

    <!-- Liste des demandes de prix (action purchase.purchase_rfq). -->
    <record id="purchase_order_kpis_tree_rpbm_pricing" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.rpbm.pricing</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="rpbm_transport_mode" optional="show"/>
            </field>
        </field>
    </record>

    <!-- Liste des bons de commande (action purchase.purchase_form_action). -->
    <record id="purchase_order_view_tree_rpbm_pricing" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.rpbm.pricing</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="rpbm_transport_mode" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
