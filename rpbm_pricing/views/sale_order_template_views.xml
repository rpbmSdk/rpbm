<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_template_view_form_rpbm_pricing" model="ir.ui.view">
        <field name="name">sale.order.template.form.rpbm.pricing</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <group name="sale_info" position="inside">
                <field name="rpbm_regime"/>
            </group>
        </field>
    </record>

    <record id="sale_order_template_view_tree_rpbm_pricing" model="ir.ui.view">
        <field name="name">sale.order.template.tree.rpbm.pricing</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="rpbm_regime" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
