<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rpbm_colisage_form" model="ir.ui.view">
        <field name="name">rpbm.colisage.form</field>
        <field name="model">rpbm.colisage</field>
        <field name="arch" type="xml">
            <form string="Colisage VSF">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ex. 941797"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="rpbm_mode" widget="radio" options="{'horizontal': true}"/>
                            <field name="date"/>
                            <field name="march_move_id" domain="[('move_type', '=', 'in_invoice')]"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="amount_pieces"/>
                            <field name="amount_fees"/>
                            <field name="coefficient"/>
                            <field name="is_retained"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="DAU" name="dau">
                            <field name="dau_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount_octroi" sum="Total"/>
                                    <field name="amount_vat_info" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Factures et avoirs" name="moves">
                            <field name="move_ids" readonly="1">
                                <tree>
                                    <field name="ref"/>
                                    <field name="name"/>
                                    <field name="invoice_date"/>
                                    <field name="move_type"/>
                                    <field name="state"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount_untaxed" string="Montant HT"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Réceptions" name="pickings">
                            <field name="picking_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="origin"/>
                                    <field name="scheduled_date"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_rpbm_colisage_tree" model="ir.ui.view">
        <field name="name">rpbm.colisage.tree</field>
        <field name="model">rpbm.colisage</field>
        <field name="arch" type="xml">
            <tree string="Colisages VSF">
                <field name="name"/>
                <field name="date"/>
                <field name="rpbm_mode"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_pieces" sum="Total"/>
                <field name="amount_fees" sum="Total"/>
                <field name="coefficient"/>
                <field name="is_retained"/>
            </tree>
        </field>
    </record>

    <record id="view_rpbm_colisage_search" model="ir.ui.view">
        <field name="name">rpbm.colisage.search</field>
        <field name="model">rpbm.colisage</field>
        <field name="arch" type="xml">
            <search string="Colisages VSF">
                <field name="name"/>
                <field name="move_ids" string="Facture" filter_domain="['|', ('move_ids.ref', 'ilike', self), ('move_ids.name', 'ilike', self)]"/>
                <filter name="plane" string="Avion" domain="[('rpbm_mode', '=', 'plane')]"/>
                <filter name="boat" string="Bateau" domain="[('rpbm_mode', '=', 'boat')]"/>
                <separator/>
                <filter name="retained" string="Retenu" domain="[('is_retained', '=', True)]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_by_year" string="Année" context="{'group_by': 'year'}"/>
                    <filter name="group_by_mode" string="Mode" context="{'group_by': 'rpbm_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rpbm_colisage" model="ir.actions.act_window">
        <field name="name">Colisages VSF</field>
        <field name="res_model">rpbm.colisage</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aucun colisage VSF</p>
            <p>Un colisage est un envoi VSF, identifié par le numéro de sa facture MARCH.
               « Reprendre l'historique » les crée depuis les factures VSF.</p>
        </field>
    </record>

    <!-- Une ligne par année, sans pivot : le coefficient annuel ne s'additionne pas. -->
    <record id="view_rpbm_colisage_year_report_tree" model="ir.ui.view">
        <field name="name">rpbm.colisage.year.report.tree</field>
        <field name="model">rpbm.colisage.year.report</field>
        <field name="arch" type="xml">
            <tree string="Coefficient annuel" create="0" edit="0" delete="0">
                <field name="year"/>
                <field name="colisage_count"/>
                <field name="amount_pieces"/>
                <field name="amount_fees"/>
                <field name="coefficient"/>
            </tree>
        </field>
    </record>

    <record id="action_rpbm_colisage_year_report" model="ir.actions.act_window">
        <field name="name">Coefficient annuel</field>
        <field name="res_model">rpbm.colisage.year.report</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_rpbm_colisage_root" name="Colisages VSF" parent="purchase.menu_purchase_root" sequence="8"
              groups="purchase.group_purchase_user"/>
    <menuitem id="menu_rpbm_colisage" name="Colisages VSF" parent="menu_rpbm_colisage_root"
              action="action_rpbm_colisage" sequence="1"/>
    <menuitem id="menu_rpbm_colisage_year_report" name="Coefficient annuel" parent="menu_rpbm_colisage_root"
              action="action_rpbm_colisage_year_report" sequence="2"/>
    <menuitem id="menu_rpbm_colisage_import_history" name="Reprendre l'historique" parent="menu_rpbm_colisage_root"
              action="action_rpbm_colisage_import_history" sequence="3" groups="purchase.group_purchase_manager"/>

    <!-- Facture fournisseur : ancres nommées seulement, le formulaire est aussi modifié par Studio. -->
    <record id="view_move_form_rpbm_colisage" model="ir.ui.view">
        <field name="name">account.move.form.rpbm.colisage</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']/field[@name='partner_bank_id']" position="after">
                <field name="rpbm_colisage_id" invisible="move_type not in ('in_invoice', 'in_refund')"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <!-- Pas de <separator/> : la personnalisation Studio de cette recherche vise search/separator[5]. -->
    <record id="view_account_invoice_filter_rpbm_colisage" model="ir.ui.view">
        <field name="name">account.move.search.rpbm.colisage</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="to_check" position="after">
                <filter name="rpbm_bill_without_colisage" string="Facture fournisseur sans colisage"
                        domain="[('move_type', 'in', ('in_invoice', 'in_refund')), ('rpbm_colisage_id', '=', False)]"
                        groups="purchase.group_purchase_user"/>
            </filter>
        </field>
    </record>

    <record id="view_picking_form_rpbm_colisage" model="ir.ui.view">
        <field name="name">stock.picking.form.rpbm.colisage</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="rpbm_colisage_id" invisible="picking_type_code != 'incoming'" options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
